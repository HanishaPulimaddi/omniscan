# =========================
# Python virtual environment
# =========================
venv/
backend/venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# =========================
# Environment variables (Secrets)
# =========================
.env
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production

# =========================
# Node / Frontend
# =========================
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/

# =========================
# Runtime uploads (DO NOT COMMIT)
# =========================
backend/app/uploads/
backend/app/uploads/**

# =========================
# Logs
# =========================
*.log

# =========================
# Editor / IDE
# =========================
.vscode/
*.code-workspace

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# PostgreSQL backups
# =========================

# Ignore full / data backups
db/*full*.sql
db/*.dump
db/*.bak

# Explicitly track schema backup
!db/omniscan_schema.sql

# =========================
# Misc (local only)
# =========================
SQL.sql
